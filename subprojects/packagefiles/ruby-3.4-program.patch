# Disables building of the Ruby executable to work around a linker error when building the Ruby executable in 32-bit ARM Linux builds in CI (https://github.com/llvm/llvm-project/issues/108262).
# Since the build always runs the baseruby with the -fake.rb script instead of miniruby, it also disables the precompiled builtin binary,
# which can only be generated by a Ruby of the exact same version.

diff --git a/configure.ac b/configure.ac
index 94f1f00..1b36a96 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1547,7 +1547,7 @@ RUBY_CHECK_SIZEOF(double)
 RUBY_CHECK_SIZEOF(time_t, [long "long long"], [], [@%:@include <time.h>])
 RUBY_CHECK_SIZEOF(clock_t, [], [], [@%:@include <time.h>])
 AC_SUBST(X_BUILTIN_BINARY, yes)
-AS_IF([test "$cross_compiling" = yes],
+AS_IF([true],
 [dnl miniruby cannot run if cross compiling
     X_BUILTIN_BINARY=no
 ],
@@ -3453,7 +3453,7 @@ for var in bindir includedir libdir rubylibprefix; do
 done
 
 BTESTRUBY='$(MINIRUBY)'
-AS_IF([test x"$cross_compiling" = xyes], [
+AS_IF([true], [
   test x"$MINIRUBY" = x && MINIRUBY="${RUBY-$BASERUBY} -I${ac_abs_builddir-.} "-r'$(arch)-fake'
   XRUBY_LIBDIR=`${RUBY-$BASERUBY} -rrbconfig -e ['puts RbConfig::CONFIG["libdir"]']`
   XRUBY_RUBYLIBDIR=`${RUBY-$BASERUBY} -rrbconfig -e ['puts RbConfig::CONFIG["rubylibdir"]']`
diff --git a/cygwin/GNUmakefile.in b/cygwin/GNUmakefile.in
index e15b6de..70bf1e9 100644
--- a/cygwin/GNUmakefile.in
+++ b/cygwin/GNUmakefile.in
@@ -58,8 +58,8 @@ $(LIBRUBY): $(RUBY_EXP) $(LIBRUBY_SO)
 $(RUBY_EXP) $(LIBRUBY_SO): $(DLL_BASE_NAME).res.$(OBJEXT)
 
 %.res.$(OBJEXT): %.rc
-	$(ECHO) compiling $@
-	$(Q) $(WINDRES) --include-dir . --include-dir $(<D) --include-dir $(srcdir)/win32 $< $@
+	rm -f $@ && $(AR) $(ARFLAGS) $@
+
 
 %.rc: $(BOOTSTRAPRUBY_FAKE) $(RBCONFIG) $(srcdir)/revision.h $(srcdir)/win32/resource.rb
 	$(ECHO) generating $@
@@ -71,9 +71,9 @@ $(RUBY_EXP) $(LIBRUBY_SO): $(DLL_BASE_NAME).res.$(OBJEXT)
 $(PROGRAM): $(RUBY_INSTALL_NAME).res.$(OBJEXT)
 $(WPROGRAM): $(RUBYW_INSTALL_NAME).res.$(OBJEXT)
 	@rm -f $@
-	$(ECHO) linking $@
-	$(Q) $(PURIFY) $(CC) $(MUNICODE_FLAG) -mwindows -e $(SYMBOL_PREFIX)mainCRTStartup $(LDFLAGS) $(XLDFLAGS) \
-	  $(MAINOBJ) $(EXTOBJS) $(LIBRUBYARG) $(LIBS) -o $@
+	touch $@
+
+
 $(STUBPROGRAM): $(RUBY_INSTALL_NAME).res.$(OBJEXT)
 
 $(RUBY_EXP): $(LIBRUBY_A)
diff --git a/template/Makefile.in b/template/Makefile.in
index 487b8ba..b44366f 100644
--- a/template/Makefile.in
+++ b/template/Makefile.in
@@ -300,9 +300,9 @@ miniruby$(EXEEXT):
 
 $(PROGRAM):
 		@$(RM) $@
-		$(ECHO) linking $@
-		$(Q) $(PURIFY) $(CC) $(EXE_LDFLAGS) $(XLDFLAGS) $(MAINOBJ) $(EXTOBJS) $(LIBRUBYARG) $(MAINLIBS) $(EXTLIBS) $(OUTFLAG)$@
-		$(Q) $(POSTLINK)
+		touch $@
+
+
 		rm -f ext/extinit.$(LIBEXT) && $(AR) $(ARFLAGS) ext/extinit.$(LIBEXT) ruby.$(OBJEXT) ext/extinit.$(OBJEXT) && ($(RANLIB) ext/extinit.$(LIBEXT) || true) && rm -f enc/encinit.$(LIBEXT) && $(AR) $(ARFLAGS) enc/encinit.$(LIBEXT) ruby.$(OBJEXT) enc/encinit.$(OBJEXT) && ($(RANLIB) enc/encinit.$(LIBEXT) || true)
 $(PROGRAM): @XRUBY_LIBPATHENV_WRAPPER@
 
