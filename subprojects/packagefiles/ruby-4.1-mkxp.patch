diff --git a/defs/jit.mk b/defs/jit.mk
--- a/defs/jit.mk
+++ b/defs/jit.mk
@@ -65,13 +65,36 @@
 endif # ifneq ($(JIT_CARGO_SUPPORT),no)
 
 RUST_LIB_SYMBOLS = $(RUST_LIB:.a=).symbols
+ifneq ($(findstring mingw,$(target_os)),)
+RUST_LIB_IMPORTS = $(RUST_LIB:.a=-imports.a)
+MAINLIBS += $(RUST_LIB_IMPORTS)
+endif
 $(RUST_LIBOBJ): $(RUST_LIB)
 	$(ECHO) 'partial linking $(RUST_LIB) into $@'
 ifneq ($(findstring darwin,$(target_os)),)
 	$(Q) $(CC) -nodefaultlibs -r -o $@ -exported_symbols_list $(RUST_LIB_SYMBOLS) $(RUST_LIB)
 else
+ifneq ($(findstring mingw,$(target_os)),)
+# mingw: binutils' ld -r drops the Rust .pdata/.xdata (SEH unwind info) once the
+# GCC-built compiler-rt objects are mixed in. Rust does not use them; libgcc
+# provides the same functions. Keep the Rust codegen units.
+# rustc's raw-dylib import stubs (*.dll[hst]*.o) go to $(RUST_LIB_IMPORTS):
+# ld -r merges their .idata sections into empty import descriptors.
+	$(Q) cp $(RUST_LIB) $@.a
+	$(Q) $(AR) d $@.a `$(AR) t $@.a | grep -v -e '\.rcgu\.o$$' -e '\.dll'`
+	$(Q) $(RM) -r $@.imp $(RUST_LIB_IMPORTS) && mkdir $@.imp && cd $@.imp && \
+	    stubs=`$(AR) t $@.a | grep '\.dll'` && $(AR) x $@.a $$stubs && \
+	    $(AR) d $@.a $$stubs && $(AR) rcs $(RUST_LIB_IMPORTS) $$stubs
+	$(Q) $(RM) -r $@.imp
+	$(Q) $(LD) -r -o $@ --whole-archive $@.a
+	$(Q) $(RM) $@.a
+else
 	$(Q) $(LD) -r -o $@ --whole-archive $(RUST_LIB)
-	-$(Q) $(OBJCOPY) --wildcard --keep-global-symbol='$(SYMBOL_PREFIX)rb_*' $(@)
+endif
+# mingw: .refptr.rb_* are COMDAT stubs shared with the C objects; keep them global.
+# Drop the Rust stdlib's embedded bitcode: on PE it is mapped far above the image.
+	-$(Q) $(OBJCOPY) --wildcard --keep-global-symbol='$(SYMBOL_PREFIX)rb_*' --keep-global-symbol='.refptr.$(SYMBOL_PREFIX)rb_*' \
+		--remove-section=.llvmbc --remove-section=.llvmcmd $(@)
 endif
 
 rust-libobj: $(RUST_LIBOBJ)
