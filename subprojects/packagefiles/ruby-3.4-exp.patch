# Disables the building of ruby.exp on Windows when Ruby is configured with `--disable-shared`.
# The file ruby.exp fails to build on the latest MSYS2 version and we don't use it.

diff --git a/cygwin/GNUmakefile.in b/cygwin/GNUmakefile.in
index 7bcf1ad..e15b6de 100644
--- a/cygwin/GNUmakefile.in
+++ b/cygwin/GNUmakefile.in
@@ -28,7 +28,7 @@ else
   endif
 endif
 
-ifneq ($(ENABLE_SHARED),yes)
+ifneq (yes,yes)
   RUBY_EXP = $(RUBY_INSTALL_NAME).exp
   EXTOBJS = $(RUBY_EXP)
   LIBRUBYARG = $(LIBRUBY_A)
@@ -104,8 +104,8 @@ endif
 $(LIBRUBY_SO): $(RUBYDEF)
 
 $(RUBYDEF): $(LIBRUBY_A) $(PREP) $(BOOTSTRAPRUBY_FAKE) $(RBCONFIG)
-	$(ECHO) generating $@
-	$(Q) $(BOOTSTRAPRUBY_COMMAND) $(srcdir)/win32/mkexports.rb -output=$@ $(LIBRUBY_A)
+	touch $@
+
 
 clean-local::
 	@$(RM) $(RUBYDEF)
