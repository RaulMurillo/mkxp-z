index e6ecd0a..a6b5b62 100644
--- a/thread_win32.c
+++ b/thread_win32.c
@@ -17,7 +17,8 @@
 #define TIME_QUANTUM_USEC (10 * 1000)
 #define RB_CONDATTR_CLOCK_MONOTONIC 1 /* no effect */
 
-#undef Sleep
+// fixes mkxp-z crashing at boot
+//#undef Sleep
 
 #define native_thread_yield() Sleep(0)
 #define unregister_ubf_list(th)
diff --git a/vm_eval.c b/vm_eval.c
index 74dfd40..a1c69c3 100644
--- a/vm_eval.c
+++ b/vm_eval.c
@@ -825,7 +825,9 @@ rb_method_call_status(rb_execution_context_t *ec, const rb_callable_method_entry
     rb_method_visibility_t visi = METHOD_ENTRY_VISI(me);
 
     /* receiver specified form for private method */
-    if (UNLIKELY(visi != METHOD_VISI_PUBLIC)) {
+
+    // public/private methods are disabled in mkxp-z
+    if (0) { //UNLIKELY(visi != METHOD_VISI_PUBLIC)) {
         if (me->def->original_id == idMethodMissing) {
             return MISSING_NONE;
         }
diff --git a/vm_insnhelper.c b/vm_insnhelper.c
index 4082fa6..5d9c8bd 100644
--- a/vm_insnhelper.c
+++ b/vm_insnhelper.c
@@ -4292,7 +4292,8 @@ vm_call_symbol(rb_execution_context_t *ec, rb_control_frame_t *reg_cfp,
                                   { .method_missing_reason = missing_reason },
                                   rb_callable_method_entry_with_refinements(klass, mid, NULL));
 
-    if (flags & VM_CALL_FCALL) {
+    // public/private methods are disabled in mkxp-z
+    if (1) { //flags & VM_CALL_FCALL) {
         return vm_call_method(ec, reg_cfp, calling);
     }
 
@@ -4904,9 +4905,13 @@ vm_call_method(rb_execution_context_t *ec, rb_control_frame_t *cfp, struct rb_ca
     if (vm_cc_cme(cc) != NULL) {
         switch (METHOD_ENTRY_VISI(vm_cc_cme(cc))) {
           case METHOD_VISI_PUBLIC: /* likely */
+
+// public/private methods are disabled in mkxp-z
+call_anyway:
             return vm_call_method_each_type(ec, cfp, calling);
 
           case METHOD_VISI_PRIVATE:
+            goto call_anyway;
             if (!(vm_ci_flag(ci) & VM_CALL_FCALL)) {
                 enum method_missing_reason stat = MISSING_PRIVATE;
                 if (vm_ci_flag(ci) & VM_CALL_VCALL) stat |= MISSING_VCALL;
@@ -4918,6 +4923,7 @@ vm_call_method(rb_execution_context_t *ec, rb_control_frame_t *cfp, struct rb_ca
             return vm_call_method_each_type(ec, cfp, calling);
 
           case METHOD_VISI_PROTECTED:
+            goto call_anyway;
             if (!(vm_ci_flag(ci) & (VM_CALL_OPT_SEND | VM_CALL_FCALL))) {
                 VALUE defined_class = vm_defined_class_for_protected_call(vm_cc_cme(cc));
                 if (!rb_obj_is_kind_of(cfp->self, defined_class)) {
@@ -5728,7 +5734,9 @@ vm_check_if_class(ID id, rb_num_t flags, VALUE super, VALUE klass)
     else if (VM_DEFINECLASS_HAS_SUPERCLASS_P(flags)) {
         VALUE tmp = rb_class_real(RCLASS_SUPER(klass));
 
-        if (tmp != super) {
+        // edited for mkxp-z
+        // makes some hackier forms of subclassing possible again
+        if (0) { //tmp != super) {
             rb_raise(rb_eTypeError,
                      "superclass mismatch for class %"PRIsVALUE"",
                      rb_id2str(id));
