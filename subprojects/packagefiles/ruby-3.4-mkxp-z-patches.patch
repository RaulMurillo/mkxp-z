# Ports the mkxp-z Ruby VM changes: disables method visibility checks (including Symbol#to_proc/public_send, which check visibility separately since Ruby 3.2),
# disables the superclass mismatch error, renames the Sleep macro to avoid a crash at boot, silences the sprintf extra-arguments warning and hides child process windows.

diff --git a/class.c b/class.c
index 8e0786f..e29fbc7 100644
--- a/class.c
+++ b/class.c
@@ -992,13 +992,16 @@ rb_define_class(const char *name, VALUE super)
                      name, rb_obj_class(klass));
         }
         if (rb_class_real(RCLASS_SUPER(klass)) != super) {
-            rb_raise(rb_eTypeError, "superclass mismatch for class %s", name);
+            // edited for mkxp-z
+            // makes some hackier forms of subclassing possible again
+            goto override_class;
         }
 
         /* Class may have been defined in Ruby and not pin-rooted */
         rb_vm_register_global_object(klass);
         return klass;
     }
+override_class:
     if (!super) {
         rb_raise(rb_eArgError, "no super class for '%s'", name);
     }
diff --git a/include/ruby/win32.h b/include/ruby/win32.h
index 80e1418..a8b1174 100644
--- a/include/ruby/win32.h
+++ b/include/ruby/win32.h
@@ -164,7 +164,9 @@ typedef int clockid_t;
 #define HAVE_GETPPID 1
 #define getppid()		rb_w32_getppid()
 #define sleep(x)		rb_w32_Sleep((x)*1000)
-#define Sleep(msec)		(void)rb_w32_Sleep(msec)
+
+// fixes mkxp-z crashing at boot
+#define RB_Sleep(msec)		(void)rb_w32_Sleep(msec)
 
 #undef HAVE_EXECV
 #define HAVE_EXECV 1
diff --git a/sprintf.c b/sprintf.c
index 90fe91c..6e82f91 100644
--- a/sprintf.c
+++ b/sprintf.c
@@ -953,11 +953,14 @@ rb_str_format_ary(int argc, const VALUE *argv, VALUE fmt, VALUE ary)
     /* XXX - We cannot validate the number of arguments if (digit)$ style used.
      */
     format_args_check(ary, argc0, argv0);
+    // Disabled this block to match older versions of ruby
+#if 0
     if (posarg >= 0 && nextarg < argc && !(argc == 2 && RB_TYPE_P(argv[1], T_HASH))) {
         const char *mesg = "too many arguments for format string";
         if (RTEST(ruby_debug)) rb_raise(rb_eArgError, "%s", mesg);
         if (RTEST(ruby_verbose)) rb_warn("%s", mesg);
     }
+#endif
     rb_str_resize(result, blen);
 
     return result;
