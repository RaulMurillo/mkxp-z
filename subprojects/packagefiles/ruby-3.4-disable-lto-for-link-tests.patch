# Allows LTO to be disabled for Ruby extensions' link tests if the environment variable MKXP_DISABLE_LTO_FOR_LINK_TESTS is set to "yes".

diff --git a/configure.ac b/configure.ac
index fb9b7ac..d582f22 100644
--- a/configure.ac
+++ b/configure.ac
@@ -423,7 +423,7 @@ AS_IF([test "$GCC" = yes], [
 
 RUBY_PROG_GNU_LD
 RUBY_CPPOUTFILE
-
+AC_SUBST(MKXP_DISABLE_LTO_FOR_LINK_TESTS)
 : ${OUTFLAG='-o '}
 : ${COUTFLAG=${OUTFLAG}}
 : ${CSRCFLAG=''}
diff --git a/lib/mkmf.rb b/lib/mkmf.rb
index 99f3764..547b077 100644
--- a/lib/mkmf.rb
+++ b/lib/mkmf.rb
@@ -606,7 +606,7 @@ def with_werror(opt, opts = nil)
 
   def try_link0(src, opt = "", ldflags: "", **opts, &b) # :nodoc:
     exe = CONFTEST+$EXEEXT
-    cmd = link_command(ldflags, opt)
+    cmd = link_command(CONFIG['MKXP_DISABLE_LTO_FOR_LINK_TESTS'] == 'yes' ? "-fno-lto #{ldflags}" : ldflags, opt)
     if $universal
       require 'tmpdir'
       Dir.mktmpdir("mkmf_", oldtmpdir = ENV["TMPDIR"]) do |tmpdir|
